<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>Preview</LangVersion>

    <!-- WIC is a Windows API; there is no other target. -->
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>

    <!-- Native shared library produced by Native AOT. -->
    <OutputType>Library</OutputType>
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <SelfContained>true</SelfContained>

    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>

    <!-- Resulting binary name MUST match the manifest's "executable" field. -->
    <AssemblyName>WicCodec</AssemblyName>
    <RootNamespace>WicCodec</RootNamespace>

    <!-- Keep in sync with "version" in igplugin.json. -->
    <Version>1.1.0</Version>
    <Product>WIC Codec for ImageGlass</Product>
    <Authors>Duong Dieu Phap</Authors>
    <Copyright>Copyright (C) 2026 Duong Dieu Phap</Copyright>

    <!-- Plugin library: not a NuGet package. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ImageGlass.SDK" Version="1.1.1" />
    <PackageReference Include="Vortice.Win32.Graphics.Imaging" Version="2.5.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Manifest must sit next to the published library so the host can discover the plugin. -->
    <None Update="igplugin.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>
</Project>
